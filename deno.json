{
  "name": "@quickflo/cli",
  "version": "1.8.1",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write mod.ts",
    "install": "deno install --global --force --name quickflo --config deno.json --allow-net --allow-read --allow-env --allow-write mod.ts",
    "test": "deno test --allow-read",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check mod.ts",
    "compile": "deno compile --allow-net --allow-read --allow-env --allow-write --output dist/quickflo mod.ts",
    "compile:all": "deno run -A scripts/compile-all.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0",
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    "proseWrap": "preserve",
    "exclude": ["dist/", "deno.lock"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["dist/"]
  },
  "exclude": ["dist/", ".github/"],
  "publish": {
    "include": ["mod.ts", "src/", "deno.json", "LICENSE", "README.md"],
    "exclude": ["src/**/*.test.ts"]
  }
}
